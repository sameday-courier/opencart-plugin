{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="float-end">
                <button type="submit" form="form-add-parcel" data-bs-toggle="tooltip" title="{{ text_create_parcel }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
                <a href="{{ cancel }}" data-bs-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
            </div>
            <h1>{{ heading_title_add_parcel }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-plus"></i> {{ text_create_parcel }}
            </div>
            <div class="card-body">
                <form action="{{ action }}" method="post" id="form-add-parcel" class="form-horizontal">
                    {% if parcel_errors is not null %}
                    <div class="alert alert-danger">
                        <ul style="margin-bottom: 0;">
                            {% for error in parcel_errors %}
                            <li><strong>{{ error }}</strong></li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}

                    <div class="form-group">
                        <label class="col-sm-2 control-label">{{ text_awb_number }}</label>
                        <div class="col-sm-10">
                            <p class="form-control-static"><strong>{{ awb_number }}</strong></p>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2 control-label">{{ text_existing_parcels }}</label>
                        <div class="col-sm-10">
                            <p class="form-control-static">{{ parcel_count }}</p>
                        </div>
                    </div>

                    <div class="form-group required">
                        <label class="col-sm-2 control-label">{{ entry_package_dimension }}</label>
                        <div class="col-sm-10">
                            <div class="row">
                                <div class="col-sm-3">
                                    <input type="number" step="any" name="sameday_package_weight[]" value="{{ calculated_weight }}" min="0.01" placeholder="{{ entry_weight }}" class="form-control" required="required"/>
                                    {% if error_weight is not null %}
                                    <div class="text-danger">{{ error_weight }}</div>
                                    {% endif %}
                                </div>
                                <div class="col-sm-3">
                                    <input type="number" step="any" name="sameday_package_width[]" value="" min="0" placeholder="{{ entry_width }}" class="form-control"/>
                                </div>
                                <div class="col-sm-3">
                                    <input type="number" step="any" name="sameday_package_length[]" value="" min="0" placeholder="{{ entry_length }}" class="form-control"/>
                                </div>
                                <div class="col-sm-3">
                                    <input type="number" step="any" name="sameday_package_height[]" value="" min="0" placeholder="{{ entry_height }}" class="form-control"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="sameday_observation"><span data-bs-toggle="tooltip" title="{{ entry_observation_title }}">{{ entry_observation }}</span></label>
                        <div class="col-sm-10">
                            <input type="text" name="sameday_observation" id="sameday_observation" value="{{ sameday_observation }}" class="form-control"/>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="sameday_parcel_last"><span data-bs-toggle="tooltip" title="{{ entry_parcel_last_title }}">{{ entry_parcel_last }}</span></label>
                        <div class="col-sm-10">
                            <div class="form-check">
                                <input type="checkbox" name="sameday_parcel_last" id="sameday_parcel_last" value="1" class="form-check-input" {% if sameday_parcel_last %}checked="checked"{% endif %}/>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{{ footer }}
