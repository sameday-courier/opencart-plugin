  <script type="text/javascript"><!--
      var bulkAwbUrl = '{{ ajax_url_bulk|e('js') }}';
      var bulkDeleteAwbUrl = '{{ ajax_url_bulk_delete|e('js') }}';
      var deleteAwbUrl = '{{ ajax_url_delete_awb|e('js') }}';
      var clearBulkErrorsUrl = '{{ ajax_url_clear_bulk_errors|e('js') }}';
      var showAwbPdfUrlBase = '{{ sameday_show_awb_pdf_url_base|e('js') }}';
      var showAwbHistoryUrlBase = '{{ sameday_show_awb_history_url_base|e('js') }}';
      var samedayButtonShowAwb = '{{ sameday_button_show_awb|e('js') }}';

      function getSelectedBulkOrderIds() {
          var ids = [];
          $('#form-order input[name^="selected"]:checked').each(function() {
              var id = $(this).val();
              if (id && id !== 'on') {
                  ids.push(id);
              }
          });
          return ids;
      }

      function renderBulkFeedbackCell(orderId, bulk) {
          var $cell = $('.feedback[data-id="' + orderId + '"]');
          if (!bulk) {
              $cell.html('&mdash;');
              return;
          }
          if (bulk.error) {
              $cell.html('<span class="text-danger">' + $('<div>').text(bulk.error).html() + '</span>');
          } else if (bulk.awb_number) {
              $cell.html(
                  '<a href="' + showAwbHistoryUrlBase + encodeURIComponent(orderId) + '">' + $('<div>').text(bulk.awb_number).html() + '</a>' +
                  ' <a href="' + showAwbPdfUrlBase + encodeURIComponent(orderId) + '" target="_blank" rel="noopener noreferrer" data-bs-toggle="tooltip" title="' + samedayButtonShowAwb + '" class="btn btn-info btn-sm"><i class="fa-solid fa-file"></i></a>' +
                  ' <button type="button" class="btn btn-danger btn-sm btn-delete-sameday-awb" data-order-id="' + orderId + '" data-bs-toggle="tooltip" title="Remove AWB"><i class="fa-solid fa-trash"></i></button>'
              );
          } else {
              $cell.html('<span class="text-muted">Pending</span>');
          }
      }

      function setBulkAwbModalHeader(mode) {
          var $icon = $('#bulkAwbHeaderIcon');
          $icon.removeClass('is-confirm is-progress is-complete');
          if (mode === 'complete') {
              $icon.addClass('is-complete').html('<i class="fa-solid fa-check"></i>');
              $('#bulkAwbModalTitle').text('AWB Generation Complete');
              $('#bulkAwbModalSubtitle').text('Shipment labels processed successfully');
          } else if (mode === 'progress') {
              $icon.addClass('is-progress').html('<i class="fa-solid fa-spinner fa-spin"></i>');
              $('#bulkAwbModalTitle').text('Generating AWBs');
              $('#bulkAwbModalSubtitle').text('Please wait while shipment labels are being created');
          } else {
              $icon.addClass('is-confirm').html('<i class="fa-solid fa-cube"></i>');
              $('#bulkAwbModalTitle').text('AWB Bulk Generation');
              $('#bulkAwbModalSubtitle').text('Review selected orders before generating shipment labels');
          }
      }

      function resetBulkAwbModal() {
          setBulkAwbModalHeader('confirm');
          $('#bulkAwbPhaseConfirm').show();
          $('#bulkAwbPhaseProgress').hide();
          $('#bulkAwbFooterConfirm').show();
          $('#bulkAwbFooterComplete').hide();
          $('#bulkAwbReport').hide();
          $('#bulkAwbLogsSection').hide();
          $('#bulkAwbLog').empty();
          $('#bulkAwbLogFilter').val('all');
          $('#bulkAwbProgressBar').css('width', '0%');
          $('#bulkAwbProgressPercent').text('0%');
          $('#bulkAwbDownloadReport').prop('disabled', true);
          $('#bulkAwbAction').removeData('bulkResults');
      }

      function prepareBulkAwbModal(orderIds) {
          resetBulkAwbModal();
          var $list = $('#bulkAwbActionOrderList').empty();
          orderIds.forEach(function(orderId) {
              $list.append('<li>Order #' + orderId + '</li>');
          });
          $('#bulkAwbActionSummary').text(
              'You are about to generate AWB for ' + orderIds.length + ' order(s).'
          );
          $('#bulkConfirm').prop('checked', false);
          $('#bulkAwbActionConfirm').prop('disabled', true);
          $('#bulkAwbAction').data('orderIds', orderIds);
      }

      function setBulkAwbProgress(done, total) {
          var percent = total ? Math.round((done / total) * 100) : 0;
          $('#bulkAwbProgressBar').css('width', percent + '%');
          $('#bulkAwbProgressPercent').text(percent + '%');
      }

      function filterBulkAwbLogs() {
          var filter = $('#bulkAwbLogFilter').val();
          $('#bulkAwbLog .sameday-bulk-log-row').each(function() {
              var status = $(this).data('log-status');
              var show = filter === 'all'
                  || (filter === 'success' && (status === 'success' || status === 'info'))
                  || (filter === 'error' && status === 'error');
              $(this).toggle(show);
          });
      }

      function appendBulkAwbLog(orderId, type, message, awbNumber) {
          var logStatus = type === 'success' ? 'success' : (type === 'error' ? 'error' : 'info');
          var iconClass = type === 'success' ? 'is-success' : (type === 'error' ? 'is-error' : 'is-info');
          var icon = type === 'success' ? 'fa-check' : (type === 'error' ? 'fa-times' : 'fa-info-circle');
          var rowClass = type === 'error' ? ' sameday-bulk-log-row is-error' : ' sameday-bulk-log-row';
          var label = '#' + orderId + ' ' + $('<div>').text(message).html();
          var pill = (awbNumber && type !== 'error')
              ? '<span class="sameday-bulk-awb-pill">' + $('<div>').text(awbNumber).html() + '</span>'
              : '';
          var line = '<div class="' + rowClass.trim() + '" data-log-status="' + logStatus + '">' +
              '<div class="sameday-bulk-log-left">' +
              '<span class="sameday-bulk-log-icon ' + iconClass + '"><i class="fa ' + icon + '"></i></span>' +
              '<span>' + label + '</span></div>' + pill + '</div>';
          $('#bulkAwbLog').append(line);
          filterBulkAwbLogs();
          $('#bulkAwbLog').scrollTop($('#bulkAwbLog')[0].scrollHeight);
      }

      function parseBulkAwbResponse(orderId, json) {
          if (!json || typeof json !== 'object') {
              return {
                  order_id: orderId,
                  status: 'error',
                  awb_number: '',
                  error: 'Empty response',
                  message: 'Empty response'
              };
          }
          if (json.sameday_bulk) {
              if (json.sameday_bulk.error) {
                  return {
                      order_id: orderId,
                      status: 'error',
                      awb_number: '',
                      error: json.sameday_bulk.error,
                      message: json.sameday_bulk.error
                  };
              }
              if (json.sameday_bulk.awb_number) {
                  return {
                      order_id: orderId,
                      status: 'success',
                      awb_number: json.sameday_bulk.awb_number,
                      error: '',
                      message: 'Successfully generated'
                  };
              }
              if (json.sameday_bulk.label && json.sameday_bulk.label !== 'Pending') {
                  return {
                      order_id: orderId,
                      status: 'error',
                      awb_number: '',
                      error: json.sameday_bulk.label,
                      message: json.sameday_bulk.label
                  };
              }
              return {
                  order_id: orderId,
                  status: 'pending',
                  awb_number: '',
                  error: '',
                  message: 'Pending'
              };
          }
          if (json.error) {
              return {
                  order_id: orderId,
                  status: 'error',
                  awb_number: '',
                  error: json.error,
                  message: json.error
              };
          }
          return {
              order_id: orderId,
              status: 'error',
              awb_number: '',
              error: 'Unknown response',
              message: 'Unknown response'
          };
      }

      function finishBulkAwbReport(results, total) {
          var successCount = 0;
          var errorCount = 0;
          results.forEach(function(row) {
              if (row.status === 'success') {
                  successCount++;
              } else if (row.status === 'error') {
                  errorCount++;
              }
          });

          setBulkAwbModalHeader('complete');
          $('#bulkAwbReportSelected').text(total);
          $('#bulkAwbReportSuccess').text(successCount);
          $('#bulkAwbReportErrors').text(errorCount);
          $('#bulkAwbReport').show();
          $('#bulkAwbDownloadReport').prop('disabled', false);
          $('#bulkAwbAction').data('bulkResults', results);
      }

      function downloadBulkAwbCsv() {
          var results = $('#bulkAwbAction').data('bulkResults') || [];
          if (!results.length) {
              return;
          }

          var lines = ['Order ID,Status,AWB Number,Message'];
          results.forEach(function(row) {
              var cells = [
                  row.order_id,
                  row.status,
                  row.awb_number || '',
                  (row.error || row.message || '').replace(/"/g, '""')
              ];
              lines.push(cells.map(function(c) { return '"' + c + '"'; }).join(','));
          });

          var blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
          var link = document.createElement('a');
          var stamp = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
          link.href = URL.createObjectURL(blob);
          link.download = 'sameday-bulk-awb-report-' + stamp + '.csv';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(link.href);
      }

      function runBulkAwbQueue(orderIds) {
          var results = [];
          var total = orderIds.length;
          var index = 0;

          setBulkAwbModalHeader('progress');
          $('#bulkAwbPhaseConfirm').hide();
          $('#bulkAwbPhaseProgress').show();
          $('#bulkAwbFooterConfirm').hide();
          $('#bulkAwbFooterComplete').show();
          $('#bulkAwbReport').hide();
          $('#bulkAwbLogsSection').show();
          $('#bulkAwbLog').empty();
          $('#bulkAwbLogFilter').val('all');
          setBulkAwbProgress(0, total);

          function processNext() {
              if (index >= total) {
                  setBulkAwbProgress(total, total);
                  finishBulkAwbReport(results, total);
                  return;
              }

              var orderId = orderIds[index];

              $.ajax({
                  url: bulkAwbUrl + '&order_id=' + encodeURIComponent(orderId),
                  type: 'GET',
                  dataType: 'json'
              }).done(function(json) {
                  if (json.already_exists) {
                      results.push({
                          order_id: orderId,
                          status: 'already_exists',
                          awb_number: json.awb_number || '',
                          error: '',
                          message: json.message
                      });
                      appendBulkAwbLog(orderId, 'info', json.message, json.awb_number || '');
                      return;
                  }

                  $('.feedback[data-id="' + orderId + '"]').html(
                      '<div class="progress" style="margin-bottom: 0;"><div class="progress-bar progress-bar-striped active" style="width: 100%;"></div></div>'
                  );

                  var row = parseBulkAwbResponse(orderId, json);
                  results.push(row);
                  appendBulkAwbLog(
                      orderId,
                      row.status === 'success' ? 'success' : 'error',
                      row.message,
                      row.awb_number || ''
                  );
                  renderBulkFeedbackCell(orderId, json.sameday_bulk || (row.error ? { error: row.error } : null));
              }).fail(function(xhr) {
                  var msg = 'Request failed';
                  try {
                      var json = JSON.parse(xhr.responseText);
                      if (json.error) {
                          msg = json.error;
                      }
                  } catch (err) {}
                  var row = {
                      order_id: orderId,
                      status: 'error',
                      awb_number: '',
                      error: msg,
                      message: msg
                  };
                  results.push(row);
                  appendBulkAwbLog(orderId, 'error', msg, '');
                  renderBulkFeedbackCell(orderId, { error: msg });
              }).always(function() {
                  index++;
                  setBulkAwbProgress(index, total);
                  processNext();
              });
          }

          processNext();
      }

      $('#bulkClearErrorsButton').on('click', function() {
          if (!confirm('Remove all bulk AWB feedback for orders that do not have a generated AWB yet?')) {
              return;
          }

          var $btn = $(this).prop('disabled', true);

          $.ajax({
              url: clearBulkErrorsUrl + '&ajax=1',
              type: 'GET',
              dataType: 'json'
          }).done(function(json) {
              if (json.success) {
                  (json.order_ids || []).forEach(function(orderId) {
                      $('.feedback[data-id="' + orderId + '"]').html('&mdash;');
                  });
                  alert('Cleared ' + (json.deleted || 0) + ' bulk feedback record(s).');
              } else if (json.error) {
                  alert(json.error);
              }
          }).fail(function(xhr) {
              var msg = 'Request failed';
              try {
                  var json = JSON.parse(xhr.responseText);
                  if (json.error) {
                      msg = json.error;
                  }
              } catch (err) {}
              alert(msg);
          }).always(function() {
              $btn.prop('disabled', false);
          });
      });

      $('#bulkAwbActionButton').on('click', function(e) {
          if (!getSelectedBulkOrderIds().length) {
              e.preventDefault();
              e.stopImmediatePropagation();
              alert('Please select at least one order.');
              return false;
          }
      });

      $('#bulkAwbAction').on('show.bs.modal', function() {
          prepareBulkAwbModal(getSelectedBulkOrderIds());
      });

      $('#bulkAwbAction').on('hidden.bs.modal', function() {
          resetBulkAwbModal();
      });

      $('#bulkConfirm').on('change', function() {
          $('#bulkAwbActionConfirm').prop('disabled', !this.checked);
      });

      $('#bulkAwbActionConfirm').on('click', function() {
          var orderIds = $('#bulkAwbAction').data('orderIds') || [];
          if (!orderIds.length || !$('#bulkConfirm').is(':checked')) {
              return;
          }
          runBulkAwbQueue(orderIds);
      });

      $('#bulkAwbDownloadReport').on('click', function() {
          downloadBulkAwbCsv();
      });

      $('#bulkAwbLogFilter').on('change', function() {
          filterBulkAwbLogs();
      });

      function setBulkDeleteModalHeader(mode) {
          var $icon = $('#bulkDeleteHeaderIcon');
          $icon.removeClass('is-confirm is-progress is-complete');
          if (mode === 'complete') {
              $icon.addClass('is-complete').html('<i class="fa-solid fa-check"></i>');
              $('#bulkDeleteModalTitle').text('AWB removal complete');
              $('#bulkDeleteModalSubtitle').text('Bulk AWB removal finished');
          } else if (mode === 'progress') {
              $icon.addClass('is-progress').html('<i class="fa-solid fa-spinner fa-spin"></i>');
              $('#bulkDeleteModalTitle').text('Removing AWBs');
              $('#bulkDeleteModalSubtitle').text('Please wait while AWBs are being removed');
          } else {
              $icon.addClass('is-confirm').html('<i class="fa-solid fa-trash"></i>');
              $('#bulkDeleteModalTitle').text('Bulk AWB removal');
              $('#bulkDeleteModalSubtitle').text('Review selected orders before removing shipment labels');
          }
      }

      function resetBulkDeleteModal() {
          setBulkDeleteModalHeader('confirm');
          $('#bulkDeletePhaseConfirm').show();
          $('#bulkDeletePhaseProgress').hide();
          $('#bulkDeleteFooterConfirm').show();
          $('#bulkDeleteFooterComplete').hide();
          $('#bulkDeleteReport').hide();
          $('#bulkDeleteLogsSection').hide();
          $('#bulkDeleteLog').empty();
          $('#bulkDeleteLogFilter').val('all');
          $('#bulkDeleteAwbProgressBar').css('width', '0%');
          $('#bulkDeleteProgressPercent').text('0%');
          $('#bulkDeleteDownloadReport').prop('disabled', true);
          $('#bulkDeleteAwbAction').removeData('bulkDeleteResults');
      }

      function prepareBulkDeleteModal(orderIds) {
          resetBulkDeleteModal();
          var $list = $('#bulkDeleteActionOrderList').empty();
          orderIds.forEach(function(orderId) {
              $list.append('<li>Order #' + orderId + '</li>');
          });
          $('#bulkDeleteActionSummary').text(
              'You are about to remove Sameday AWB for ' + orderIds.length + ' order(s).'
          );
          $('#bulkDeleteConfirm').prop('checked', false);
          $('#bulkDeleteActionConfirm').prop('disabled', true);
          $('#bulkDeleteAwbAction').data('orderIds', orderIds);
      }

      function setBulkDeleteProgress(done, total) {
          var percent = total ? Math.round((done / total) * 100) : 0;
          $('#bulkDeleteAwbProgressBar').css('width', percent + '%');
          $('#bulkDeleteProgressPercent').text(percent + '%');
      }

      function filterBulkDeleteLogs() {
          var filter = $('#bulkDeleteLogFilter').val();
          $('#bulkDeleteLog .sameday-bulk-log-row').each(function() {
              var status = $(this).data('log-status');
              var show = filter === 'all'
                  || (filter === 'success' && status === 'success')
                  || (filter === 'error' && status === 'error');
              $(this).toggle(show);
          });
      }

      function appendBulkDeleteLog(orderId, type, message, awbNumber) {
          var logStatus = type === 'success' ? 'success' : 'error';
          var iconClass = type === 'success' ? 'is-success' : 'is-error';
          var icon = type === 'success' ? 'fa-check' : 'fa-times';
          var rowClass = type === 'error' ? ' sameday-bulk-log-row is-error' : ' sameday-bulk-log-row';
          var label = '#' + orderId + ' ' + $('<div>').text(message).html();
          var pill = (awbNumber && type === 'success')
              ? '<span class="sameday-bulk-awb-pill">' + $('<div>').text(awbNumber).html() + '</span>'
              : '';
          var line = '<div class="' + rowClass.trim() + '" data-log-status="' + logStatus + '">' +
              '<div class="sameday-bulk-log-left">' +
              '<span class="sameday-bulk-log-icon ' + iconClass + '"><i class="fa ' + icon + '"></i></span>' +
              '<span>' + label + '</span></div>' + pill + '</div>';
          $('#bulkDeleteLog').append(line);
          filterBulkDeleteLogs();
          $('#bulkDeleteLog').scrollTop($('#bulkDeleteLog')[0].scrollHeight);
      }

      function finishBulkDeleteReport(results, total) {
          var successCount = 0;
          var errorCount = 0;
          results.forEach(function(row) {
              if (row.status === 'success') {
                  successCount++;
              } else if (row.status === 'error') {
                  errorCount++;
              }
          });
          setBulkDeleteModalHeader('complete');
          $('#bulkDeleteReportSelected').text(total);
          $('#bulkDeleteReportSuccess').text(successCount);
          $('#bulkDeleteReportErrors').text(errorCount);
          $('#bulkDeleteReport').show();
          $('#bulkDeleteDownloadReport').prop('disabled', false);
          $('#bulkDeleteAwbAction').data('bulkDeleteResults', results);
      }

      function downloadBulkDeleteCsv() {
          var results = $('#bulkDeleteAwbAction').data('bulkDeleteResults') || [];
          if (!results.length) {
              return;
          }
          var lines = ['Order ID,Status,AWB Number,Message'];
          results.forEach(function(row) {
              var cells = [
                  row.order_id,
                  row.status,
                  row.awb_number || '',
                  (row.error || row.message || '').replace(/"/g, '""')
              ];
              lines.push(cells.map(function(c) { return '"' + c + '"'; }).join(','));
          });
          var blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
          var link = document.createElement('a');
          var stamp = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
          link.href = URL.createObjectURL(blob);
          link.download = 'sameday-bulk-delete-awb-report-' + stamp + '.csv';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(link.href);
      }

      function runBulkDeleteAwbQueue(orderIds) {
          var results = [];
          var total = orderIds.length;
          var index = 0;

          setBulkDeleteModalHeader('progress');
          $('#bulkDeletePhaseConfirm').hide();
          $('#bulkDeletePhaseProgress').show();
          $('#bulkDeleteFooterConfirm').hide();
          $('#bulkDeleteFooterComplete').show();
          $('#bulkDeleteReport').hide();
          $('#bulkDeleteLogsSection').show();
          $('#bulkDeleteLog').empty();
          $('#bulkDeleteLogFilter').val('all');
          setBulkDeleteProgress(0, total);

          function processNext() {
              if (index >= total) {
                  setBulkDeleteProgress(total, total);
                  finishBulkDeleteReport(results, total);
                  return;
              }

              var orderId = orderIds[index];

              $.ajax({
                  url: bulkDeleteAwbUrl + '&order_id=' + encodeURIComponent(orderId),
                  type: 'GET',
                  dataType: 'json'
              }).done(function(json) {
                  if (json.success) {
                      var successMsg = json.message || 'AWB removed successfully';
                      results.push({
                          order_id: orderId,
                          status: 'success',
                          awb_number: json.awb_number || '',
                          error: '',
                          message: successMsg
                      });
                      appendBulkDeleteLog(orderId, 'success', successMsg, json.awb_number || '');
                      $('.feedback[data-id="' + orderId + '"]').html('&mdash;');
                  } else {
                      var msg = json.error || json.message || 'Unknown error';
                      results.push({
                          order_id: orderId,
                          status: 'error',
                          awb_number: json.awb_number || '',
                          error: msg,
                          message: msg
                      });
                      appendBulkDeleteLog(orderId, 'error', msg, '');
                  }
              }).fail(function(xhr) {
                  var msg = 'Request failed';
                  try {
                      var json = JSON.parse(xhr.responseText);
                      if (json.error) {
                          msg = json.error;
                      }
                  } catch (err) {}
                  results.push({
                      order_id: orderId,
                      status: 'error',
                      awb_number: '',
                      error: msg,
                      message: msg
                  });
                  appendBulkDeleteLog(orderId, 'error', msg, '');
              }).always(function() {
                  index++;
                  setBulkDeleteProgress(index, total);
                  processNext();
              });
          }

          processNext();
      }

      $('#bulkDeleteAwbActionButton').on('click', function(e) {
          if (!getSelectedBulkOrderIds().length) {
              e.preventDefault();
              e.stopImmediatePropagation();
              alert('Please select at least one order.');
              return false;
          }
      });

      $('#bulkDeleteAwbAction').on('show.bs.modal', function() {
          prepareBulkDeleteModal(getSelectedBulkOrderIds());
      });

      $('#bulkDeleteAwbAction').on('hidden.bs.modal', function() {
          resetBulkDeleteModal();
      });

      $('#bulkDeleteConfirm').on('change', function() {
          $('#bulkDeleteActionConfirm').prop('disabled', !this.checked);
      });

      $('#bulkDeleteActionConfirm').on('click', function() {
          var orderIds = $('#bulkDeleteAwbAction').data('orderIds') || [];
          if (!orderIds.length || !$('#bulkDeleteConfirm').is(':checked')) {
              return;
          }
          runBulkDeleteAwbQueue(orderIds);
      });

      $('#bulkDeleteDownloadReport').on('click', function() {
          downloadBulkDeleteCsv();
      });

      $('#bulkDeleteLogFilter').on('change', function() {
          filterBulkDeleteLogs();
      });

      $(document).on('click', '.btn-delete-sameday-awb', function(e) {
          e.preventDefault();
          e.stopPropagation();

          if (!confirm('Remove Sameday AWB for this order?')) {
              return;
          }

          var orderId = $(this).data('order-id');
          var $btn = $(this);
          $btn.prop('disabled', true);

          $.ajax({
              url: deleteAwbUrl + '&order_id=' + encodeURIComponent(orderId) + '&ajax=1',
              type: 'GET',
              dataType: 'json'
          }).done(function(json) {
              if (json.success) {
                  $('.feedback[data-id="' + orderId + '"]').html('&mdash;');
                  $btn.closest('td').find('.btn-delete-sameday-awb').remove();
                  if (json.local_only && json.message) {
                      alert(json.message);
                  }
              } else if (json.error) {
                  var force = confirm(
                      json.error + '\n\nRemove the local AWB link anyway so you can continue with this order?'
                  );
                  if (force) {
                      $.ajax({
                          url: deleteAwbUrl + '&order_id=' + encodeURIComponent(orderId) + '&ajax=1&force_local=1',
                          type: 'GET',
                          dataType: 'json'
                      }).done(function(forceJson) {
                          if (forceJson.success) {
                              $('.feedback[data-id="' + orderId + '"]').html('&mdash;');
                              $btn.closest('td').find('.btn-delete-sameday-awb').remove();
                              if (forceJson.message) {
                                  alert(forceJson.message);
                              }
                          } else {
                              alert(forceJson.error || 'Failed to remove local AWB link');
                              $btn.prop('disabled', false);
                          }
                      }).fail(function() {
                          alert('Request failed');
                          $btn.prop('disabled', false);
                      });
                      return;
                  }
                  $btn.prop('disabled', false);
              }
          }).fail(function(xhr) {
              var msg = 'Request failed';
              try {
                  var json = JSON.parse(xhr.responseText);
                  if (json.error) {
                      msg = json.error;
                  }
              } catch (err) {}
              alert(msg);
              $btn.prop('disabled', false);
          });
      });
