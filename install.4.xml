<?xml version="1.0" encoding="utf-8"?>
<modification>
    <name>Samedaycourier Plugin OC v4</name>
    <code>sameday-order-list-bulk-awb</code>
    <version>1.8.0</version>
    <author>Sameday Courier</author>
    <link>https://www.sameday.ro/</link>
    <file path="admin/view/template/sale/order_list.twig">
        <operation>
            <search><![CDATA[
                <td class="text-right">{{ column_action }}</td>
            ]]></search>
            <add position="before"><![CDATA[
                <td class="text-right">Feedback</td>
            ]]></add>
        </operation>
        <operation>
            <search><![CDATA[
                <td class="text-left">{{ order.date_modified }}</td>
            ]]></search>
            <add position="after"><![CDATA[
                <td class="text-center">
                  {% if order.sameday_bulk %}
                    {% if order.sameday_bulk.error %}
                      <span class="text-danger">{{ order.sameday_bulk.error }}</span>
                    {% elseif order.sameday_bulk.awb_number %}
                      {% if order.show_awb_history_link %}
                      <a href="{{ order.show_awb_history_link }}">{{ order.sameday_bulk.awb_number }}</a>
                      {% else %}
                      {{ order.sameday_bulk.awb_number }}
                      {% endif %}
                      {% if order.show_awb_pdf_link %}
                      <a href="{{ order.show_awb_pdf_link }}" data-toggle="tooltip" title="{{ sameday_button_show_awb }}" class="btn btn-info btn-xs"><i class="fa fa-file"></i></a>
                      {% endif %}
                    {% else %}
                      <span class="text-muted">Pending</span>
                    {% endif %}
                  {% else %}
                    &mdash;
                  {% endif %}
                </td>
            ]]></add>
        </operation>
        <operation>
            <search><![CDATA[
                <td class="text-center" colspan="8">{{ text_no_results }}</td>
            ]]></search>
            <add position="replace"><![CDATA[
                <td class="text-center" colspan="9">{{ text_no_results }}</td>
            ]]></add>
        </operation>
    </file>
</modification>
